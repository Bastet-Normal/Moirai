# ==========================================
# 网文小说生成 Agent 系统 (NovelEngine) 配置文件
# ==========================================

# OpenAI 兼容协议配置 (支持 OpenAI / OneAPI / NewAPI / DeepSeek / Claude中转 等)
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# 模型路由配置 (可统一使用同一个模型，也可按职责分工)
# 默认主模型 (推荐 claude-3-5-sonnet, deepseek-chat, gpt-4o 等)
DEFAULT_MODEL=deepseek-chat

# 核心主笔模型 (负责正文扩写，建议使用文笔和故事性强的模型)
WRITER_MODEL=deepseek-chat

# 策划与大纲模型 (负责架构、世界观、拆细纲)
PLANNER_MODEL=deepseek-chat

# 质检与审稿模型 (负责逻辑审查、吃设定检验)
CRITIC_MODEL=deepseek-chat

# 状态提取模型 (负责提取背包变化、人设状态等，可用快速经济型模型如 deepseek-chat, gpt-4o-mini)
STATE_MODEL=deepseek-chat

# 生成参数
TEMPERATURE=0.75
MAX_RETRIES=3

# 质检严格度: strict(苛刻,分<8.5打回) / standard(标准,分<7.0打回) / lenient(宽松,分<5.5打回)
AUDIT_STRICTNESS=standard
# 推理模型出长内容较慢，建议不低于 120
REQUEST_TIMEOUT=180

# 项目输出目录
OUTPUT_DIR=./novel_projects
