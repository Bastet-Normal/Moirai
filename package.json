{
  "name": "moirai-local-ui-assets",
  "private": true,
  "scripts": {
    "test:web": "node --test tests/web_state.test.mjs",
    "test:browser": "playwright test --project=chromium",
    "test:browser:all": "playwright test",
    "build:web": "tailwindcss -i web/tailwind.input.css -o web/assets/tailwind.min.css --minify && node scripts/build_web_assets.mjs"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "6.7.2",
    "@playwright/test": "1.62.1",
    "@tailwindcss/cli": "4.3.3",
    "cytoscape": "3.34.2",
    "tailwindcss": "4.3.3"
  },
  "allowScripts": {
    "@parcel/watcher": false
  }
}
